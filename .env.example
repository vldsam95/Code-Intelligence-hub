CODEINTEL_ENV=production
CODEINTEL_BASE_URL=https://code-hub.example.com
CODEINTEL_DATABASE_URL=sqlite:////data/codeintel-hub.db
CODEINTEL_ARTIFACTS_DIR=/artifacts
CODEINTEL_DOCS_DIR=/app/docs
CODEINTEL_MASTER_KEY_FILE=/run/codeintel-secrets/hub-master.key
CODEINTEL_OWNER_USERNAME=change-me
CODEINTEL_OWNER_PASSWORD_HASH=
CODEINTEL_SESSION_SECRET=
CODEINTEL_TOKEN_HMAC_KEY=
CODEINTEL_TRUSTED_HOSTS=code-hub.example.com,localhost,127.0.0.1
CODEINTEL_SECURE_COOKIES=true
CODEINTEL_LOG_LEVEL=INFO
CODEINTEL_HUB_VERSION=1.3.0
CODEINTEL_AGENT_POLICY_VERSION=4
CODEINTEL_WORKER_MCP_SCHEMA_VERSION=1
CODEINTEL_HUB_MCP_SCHEMA_VERSION=1
CODEINTEL_PROJECT_MANIFEST_SCHEMA_VERSION=1
